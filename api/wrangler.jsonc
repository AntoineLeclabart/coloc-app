// Configuration du Worker Cloudflare : l'API (src/) et le front Angular compilé (assets).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coloc",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "assets": {
    "directory": "../front/dist/front/browser",
    "binding": "ASSETS",
    // Les routes Angular (/bilan, /depenses…) renvoient index.html.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "coloc",
      // Base créée avec `npx wrangler d1 create coloc` (voir DEPLOIEMENT.md).
      "database_id": "72ba0c27-4ac1-4578-b6a8-b78319164dff",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
