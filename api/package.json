{
  "name": "coloc-api",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node -e \"require('fs').mkdirSync('../front/dist/front/browser',{recursive:true})\"",
    "dev": "wrangler d1 migrations apply DB --local && wrangler dev --ip 0.0.0.0 --port 8000",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "hash-password": "node scripts/hash-password.mjs",
    "deploy": "npm --prefix ../front ci && npm --prefix ../front run build && wrangler d1 migrations apply DB --remote && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261006.1",
    "typescript": "~5.9",
    "vitest": "^4.1.11",
    "wrangler": "^4.148.0"
  },
  "allowScripts": {
    "workerd@1.20260815.1": true,
    "workerd@1.20261006.1": true,
    "esbuild@0.28.1": true,
    "sharp@0.35.2": true,
    "sharp@0.35.4": true
  }
}
