# Copier ce fichier en deploy/coloc.env sur le serveur (il n'est pas versionné),
# puis remplir les trois valeurs. Garder les apostrophes autour des valeurs.

# Nom de domaine qui pointe vers l'IP publique de la VM.
SERVER_NAME='coloc-exemple.duckdns.org'

# Clé secrète de Symfony (signe les cookies « rester connecté »).
# Générer avec : openssl rand -hex 32
APP_SECRET='a-remplacer'

# Hash du mot de passe de la coloc. Générer avec :
#   docker compose -f compose.prod.yaml run --rm app php bin/console security:hash-password
COLOC_MOT_DE_PASSE_HASH='$2y$13$a-remplacer'
